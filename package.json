{
  "name": "pi-transcript-ui",
  "version": "0.6.1",
  "description": "Compact tool summaries for Pi with optional purpose text and adjacent-call grouping. Native execution and expanded output are preserved.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isty2e/pi-transcript-ui.git"
  },
  "homepage": "https://github.com/isty2e/pi-transcript-ui#readme",
  "bugs": {
    "url": "https://github.com/isty2e/pi-transcript-ui/issues"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.4.1",
    "@types/semver": "7.8.0",
    "pi-compat-fixture": "npm:@earendil-works/pi-coding-agent@1.1.0",
    "pi-legacy-fixture": "npm:@earendil-works/pi-coding-agent@0.85.1",
    "semver": "7.8.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  },
  "overrides": {
    "pi-compat-fixture": {
      "@earendil-works/chord": "1.1.0",
      "@earendil-works/pi-agent-core": "1.1.0",
      "@earendil-works/pi-ai": "1.1.0",
      "@earendil-works/pi-codemode": "1.1.0",
      "@earendil-works/pi-mcp": "1.1.0",
      "@earendil-works/pi-tui": "1.1.0"
    },
    "pi-legacy-fixture": {
      "@earendil-works/chord": "0.85.1",
      "@earendil-works/pi-agent-core": "0.85.1",
      "@earendil-works/pi-ai": "0.85.1",
      "@earendil-works/pi-tui": "0.85.1"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run"
  },
  "pi": {
    "extensions": [
      "./src"
    ]
  }
}
